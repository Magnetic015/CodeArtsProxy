CODEARTS_INFERENCE_API_KEYS=replace-with-a-long-random-client-key
CODEARTS_ADMIN_API_KEY=replace-with-a-separate-long-random-admin-key
CODEARTS_CHECKIN_MUTATIONS=false
CODEARTS_CHECKIN_CONFIRM=false
CODEARTS_ACCOUNTS_FILE=/run/secrets/accounts.json
CODEARTS_STATE_DB=/var/lib/codearts-proxy/state.sqlite3
