# Keep actual secrets outside the repository and Docker build context.
CODEARTS_SECRETS_DIR=/absolute/private/codearts-secrets
CODEARTS_PORT=8080
# Conservative default until your daily campaign's eligibility is verified.
CODEARTS_CHECKIN_MUTATIONS=false
CODEARTS_CHECKIN_CONFIRM=false
# Explicit proxy only; host proxy environment is not inherited by upstream HTTP.
CODEARTS_UPSTREAM_PROXY=
